SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=local

# Veritabanı ayarları (örnek değerler - gerçek şifre yazma)
DB_URL=jdbc:postgresql://localhost:5432/campushub_auth
DB_USERNAME=auth_user
DB_PASSWORD=changeme

# JWT ayarları (örnek değer - gerçek gizli anahtarı .env içine koy)
JWT_SECRET=change-this-secret-key-in-local-env
JWT_EXPIRATION_MS=86400000